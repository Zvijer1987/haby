services:
  haby:
    image: zvijer1987/haby:latest
    container_name: haby
    restart: unless-stopped
    ports:
      - "50031:3000"
    # Store the SQLite database and uploaded assets persistently.
    volumes:
      - ./data:/data
    # Optional runtime environment values.
    environment:
      NODE_ENV: production
      PORT: 3000
    # Basic container hardening.
    security_opt:
      - no-new-privileges:true
    # Graceful shutdown for cleaner restarts.
    stop_grace_period: 20s
