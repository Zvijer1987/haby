services:
  haby:
    image: zvijer1987/haby:latest        # Docker image from Docker Hub
    container_name: haby                 # Container name
    restart: unless-stopped              # Automatically restart unless stopped manually

    # Persistent storage for application data (SQLite database and uploads)
    volumes:
      - /path/to/haby/data:/data

    # Temporary direct access for testing without reverse proxy
    ports:
      - "50055:3000"

    # Basic container hardening
    security_opt:
      - no-new-privileges:true

    # Runtime environment configuration
    environment:
      NODE_ENV: production               # Enables production optimizations
      PORT: 3000                         # Internal application port
      TZ: Europe/Country                 # Timezone

      # Cookie security behavior:
      # false = allows HTTP (useful for local testing via IP:port)
      # true  = requires HTTPS (recommended for production behind reverse proxy)
      COOKIE_SECURE: "false"
